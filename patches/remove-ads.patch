-  ctx.fillStyle = RESULT_BAND_COLOR;
-  ctx.fillRect(0, bandY, w, bandH);
-
-  const logoX = (w - logoSize) / 2;
-
-  if (logo) {
-    ctx.drawImage(logo, logoX, contentY, logoSize, logoSize);
-  }
-
-  const colX = logoX + logoSize + RESULT_GAP;
