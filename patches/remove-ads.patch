-
-    const creativeCursor = this._creativeCursors.get(ad.id) ?? randomStart();
-    this._creativeCursors.set(ad.id, creativeCursor + 1);
-
-    // 슬롯마다 장수가 달라 같은 커서라도 각자의 주기로 돈다 (프리롤은 1장이라 늘 같다)
-    const creatives: AdCreativeMap<string> = {};
